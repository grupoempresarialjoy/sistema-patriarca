{
  "hosting": [
    {
      "site": "portal-aj16",
      "public": ".",
      "ignore": [
        "firebase.json",
        "seed-users.html",
        ".firebaserc",
        "functions/**",
        "**/node_modules/**",
        "**/.*"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}